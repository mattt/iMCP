<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.amesconsulting.imcp.mac.pairing</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>imcp</string>
			</array>
		</dict>
	</array>
	<key>LSMultipleInstancesProhibited</key>
	<true/>
	<key>NSAppleEventsUsageDescription</key>
	<string>iMCP uses Apple Events to control and read now playing data from Music, to create notes and folders in Notes when you allow it, and to send messages through Messages after you confirm each one.</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>iMCP uses Apple Music access to search the Apple Music catalog.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_imcp-helper._tcp</string>
	</array>
	<key>SUEnableInstallerLauncherService</key>
	<true/>
</dict>
</plist>
